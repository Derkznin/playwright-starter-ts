{
  "name": "playwright-starter-ts",
  "version": "1.0.0",
  "description": "Reusable Playwright and TypeScript test automation template",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write --list-different",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "plop": "plop"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "e2e",
    "template"
  ],
  "author": "Corentin H.",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "plop": "^4.0.5",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
